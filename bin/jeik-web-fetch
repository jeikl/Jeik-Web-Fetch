#!/usr/bin/env python3
import sys
import argparse
from jeik_web_fetch import firecrawl_fetch

def main():
    parser = argparse.ArgumentParser(description="Jeik-Web-Fetch: 高性能通用网页抓取与反反爬 Markdown 提取命令行工具")
    parser.add_argument("url", help="目标网页 URL")
    parser.add_argument("-t", "--timeout", type=float, default=20.0, help="总超时时间 (默认: 20s)")
    parser.add_argument("-w", "--wait", type=float, default=4.0, help="页面异步渲染等待时间 (默认: 4s)")
    parser.add_argument("-o", "--output", help="输出 Markdown 文件路径 (默认打印到标准输出)")

    args = parser.parse_args()

    try:
        md = firecrawl_fetch(args.url, timeout=args.timeout, wait_render_sec=args.wait)
        if args.output:
            with open(args.output, "w", encoding="utf-8") as f:
                f.write(md)
            print(f"[+] 抓取成功，结果已保存至: {args.output}")
        else:
            print(md)
    except Exception as e:
        print(f"[-] 抓取失败: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
