#!/usr/bin/env python3
import sys
import os

# 确保脚本即使未通过 pip install 安装也能直接运行
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))

import argparse
from jeik_web_fetch import firecrawl_fetch, run_server

def main():
    parser = argparse.ArgumentParser(
        description="Jeik-Web-Fetch: 高性能通用网页抓取与反反爬 Markdown 提取工具 (CLI / HTTP Server)"
    )
    subparsers = parser.add_subparsers(dest="command", help="运行模式")

    # 1. 抓取命令: jeik-web-fetch fetch <url>
    fetch_parser = subparsers.add_parser("fetch", help="直接抓取指定 URL 并返回 Markdown")
    fetch_parser.add_argument("url", help="目标网页 URL")
    fetch_parser.add_argument("-t", "--timeout", type=float, default=20.0, help="总超时时间 (默认: 20s)")
    fetch_parser.add_argument("-w", "--wait", type=float, default=4.0, help="页面异步渲染等待时间 (默认: 4s)")
    fetch_parser.add_argument("-o", "--output", help="输出 Markdown 文件路径 (默认打印到标准输出)")

    # 2. 服务端命令: jeik-web-fetch serve
    serve_parser = subparsers.add_parser("serve", help="启动 HTTP API 服务")
    serve_parser.add_argument("--host", default="0.0.0.0", help="监听地址 (默认: 0.0.0.0)")
    serve_parser.add_argument("-p", "--port", type=int, default=8000, help="监听端口 (默认: 8000)")

    # 兼容直接传入 URL 的简写模式: jeik-web-fetch https://example.com
    if len(sys.argv) > 1 and not sys.argv[1].startswith("-") and sys.argv[1] not in ["fetch", "serve", "help"]:
        sys.argv.insert(1, "fetch")

    args = parser.parse_args()

    if args.command == "serve":
        run_server(host=args.host, port=args.port)
        return

    if args.command == "fetch":
        try:
            md = firecrawl_fetch(args.url, timeout=args.timeout, wait_render_sec=args.wait)
            if args.output:
                with open(args.output, "w", encoding="utf-8") as f:
                    f.write(md)
                print(f"[+] 抓取成功，结果已保存至: {args.output}")
            else:
                print(md)
        except Exception as e:
            print(f"[-] 抓取失败: {e}", file=sys.stderr)
            sys.exit(1)
        return

    parser.print_help()

if __name__ == "__main__":
    main()
